# Образ кабинета (Next.js). next.config.ts без output: "standalone", поэтому запуск — `next start` с
# production-зависимостями; standalone уменьшит образ, когда его включат в конфиге.
# NEXT_PUBLIC_* встраиваются при сборке — это публичные значения, не секреты.
FROM node:22-alpine AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ .
ARG NEXT_PUBLIC_YM_ID=""
ARG NEXT_PUBLIC_YANDEX_VERIFICATION=""
RUN npm run build && npm prune --omit=dev

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
COPY --from=build --chown=node:node /app ./
USER node
EXPOSE 3000
CMD ["node_modules/.bin/next", "start"]
