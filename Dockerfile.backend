# Образ backend: api и worker — одна картинка, разные команды (docker-compose.yml).
#   api:     uvicorn app.api:create_app --factory (CMD по умолчанию)
#   worker:  python -m app.worker.main
#   migrate: python -m migrations
# Секретов в образе нет: строки подключения, ключи шифрования и токены — только переменные окружения.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app
COPY backend/requirements.txt .
RUN pip install -r requirements.txt

COPY backend/app ./app
COPY backend/migrations ./migrations

# Версия кода для releases (воркер пишет её в результаты): передаётся при сборке, в CI — github.sha.
ARG RELEASE_COMMIT_SHA=""
ARG RELEASE_BUILD_ID=""
ENV RELEASE_COMMIT_SHA=${RELEASE_COMMIT_SHA} RELEASE_BUILD_ID=${RELEASE_BUILD_ID}

RUN useradd --system --uid 10001 --no-create-home app
USER 10001

EXPOSE 8000
CMD ["uvicorn", "app.api:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
