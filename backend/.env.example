# Template only. Keep real credentials in a deployment secret manager; do not commit .env.
# API_DATABASE_URL must use app_rw (never postgres, app_system, app_token or app_migrator).
API_DATABASE_URL=
# Exact frontend Origin(s), comma-separated, no trailing slash or wildcard.
API_ALLOWED_ORIGINS=
API_HSTS=1
API_SESSION_COOKIE=session
API_POOL_MIN=1
API_POOL_MAX=10
API_MAX_BODY_BYTES=65536

# Disabled until the operator configures a real Yandex ID application and reviewed legal documents.
YANDEX_LOGIN_ENABLED=0
YANDEX_LOGIN_CLIENT_ID=
YANDEX_LOGIN_CLIENT_SECRET=
# https://<your-frontend-domain>/api/auth/yandex/callback
# Must belong to API_ALLOWED_ORIGINS. HTTP is permitted only for local development.
YANDEX_LOGIN_REDIRECT_URI=

# JSON document -> exact SHA256 of its approved backend text. Empty = registration blocked.
# Existing users can sign in without accepting new documents. Do not approve the bundled draft texts.
# Example SHAPE only: {"offer":"<approved-text-sha256>","pd_consent":"<approved-text-sha256>"}
# If marketing acceptance is offered, its exact approved hash is required too.
API_SIGNUP_APPROVED_HASHES={}

# Frontend server config, in frontend deployment (not NEXT_PUBLIC_*):
# INROU_API_URL=http://127.0.0.1:8080
# INROU_SESSION_COOKIE=session

# Own email/password authentication. Keep disabled until mail, trusted ingress and approved documents are configured.
INROU_EMAIL_ENABLED=false
# smtp (default) or unisender (HTTPS API; works without outbound SMTP).
INROU_MAIL_PROVIDER=unisender
INROU_MAIL_API_KEY=
INROU_EMAIL_ORIGIN=https://your-domain.example
INROU_AUTH_HMAC_KEY=
INROU_SMTP_HOST=
INROU_SMTP_PORT=587
INROU_SMTP_FROM=
INROU_SMTP_USER=
INROU_SMTP_PASSWORD=
# SMTP uses STARTTLS, or implicit TLS on port 465. No plaintext production fallback.

# Separate Yandex API application, NOT the Yandex ID login application.
# Its application must be approved for Direct API access. Keep off until configured.
YANDEX_API_ENABLED=0
YANDEX_API_CLIENT_ID=
YANDEX_API_CLIENT_SECRET=
# New API applications have this fixed URI: clients paste the short-lived code into their workspace.
# Legacy web applications may instead use https://your-domain.example/api/direct/callback.
YANDEX_API_REDIRECT_URI=https://oauth.yandex.ru/verification_code
TOKEN_ENCRYPTION_KEY_VERSION=1
# Base64 encoding of 32 cryptographically random bytes. Back up securely; losing it loses token access.
TOKEN_ENCRYPTION_KEY_1=

# Explicit, expiring pilot grant; empty = no free access. No payment records are fabricated.
# IDs come from /api/v1/me after the user has signed in.
PILOT_WORKSPACE_IDS=
# Allow newly registered clients during an operator-defined launch test. Expiry is still required.
PILOT_OPEN_ACCESS=0
PILOT_ACCESS_UNTIL=

# Worker process: app_token for scoped token reads, app_system for queue discovery.
WORKER_DATABASE_URL=
WORKER_QUEUE_DATABASE_URL=
RELEASE_COMMIT_SHA=
RELEASE_BUILD_ID=

# Same secret on Next.js and API (at least 32 characters).
# Accept signed visitor IPs only from the controlled Next.js proxy.
API_PROXY_HMAC_KEY=

# Dedicated retention process; deploy bootstrap provisions app_deleter DSN.
RETENTION_ENABLED=0
RETENTION_DATABASE_URL=
# Only a header overwritten by the controlled ingress, e.g. deploy/Caddyfile.
INROU_CLIENT_IP_HEADER=

# YooKassa: keep disabled until approved operator terms, merchant and fiscal settings exist.
INROU_BILLING_ENABLED=0
INROU_BILLING_LEGAL_APPROVED=0
INROU_BILLING_LIVE_APPROVED=0
INROU_BILLING_ORIGIN=
INROU_BILLING_TERMS_SHA256=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_TEST_MODE=1
YOOKASSA_VAT_CODE=
YOOKASSA_TAX_SYSTEM_CODE=
YOOKASSA_PAYMENT_SUBJECT=
YOOKASSA_PAYMENT_MODE=

# When email is enabled, deploy/serve.py also starts app.worker.auth_mail_runner.
# Standalone API deployments must run it separately with the same auth HMAC key and email provider config.
# Its only database connection is WORKER_QUEUE_DATABASE_URL (app_system); Direct worker may remain disabled.

# Public contact approved by the owner. This address is public, never a credential.
INROU_PUBLIC_CONTACT_EMAIL=woorldmub@gmail.com
# Optional service alerts, OFF until provider/operator acceptance and per-user opt-in.
INROU_PRODUCT_EMAIL_ENABLED=0
# Monitor worker progress separately from API liveness:
# python -m app.worker.progress --worker sync --worker product_mail --max-age 300 --max-queue-age 900
